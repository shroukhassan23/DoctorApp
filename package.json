{
  "name": "doctor-app-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Medical Practice Management Desktop Application",
  "author": "Doctor App Team <contact@doctorapp.com>",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "ELECTRON_DEV=true electron electron.cjs",
    "build": "vite build --outDir app_dist",
    "build:dev": "vite build --mode development --outDir app_dist",
    "prepare:mysql": "node scripts/extract-mysql.cjs",
    "prepare:installer": "node scripts/create-installer.cjs",
    "prepare:native": "node scripts/prepare-native-modules.cjs",
    "rebuild:sqlite": "npm uninstall better-sqlite3 && npm install better-sqlite3 --build-from-source",
    "prepare:build": "npm run build && npm run prepare:mysql && npm run prepare:native && npm run prepare:installer",
    "dist": "npm run prepare:build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run prepare:build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run prepare:build && electron-builder --mac --config electron-builder.yml",
    "pack": "npm run prepare:build && electron-builder --dir --config electron-builder.yml",
    "clean": "rimraf app_dist dist-installers dist-native mysql-resources/mysql-* build node_modules/.cache",
    "clean:full": "npm run clean && rimraf node_modules package-lock.json",
    "rebuild": "npm run clean && npm install && npm run dist",
    "rebuild:full": "npm run clean:full && npm install && npm run dist",
    "install-services": "node scripts/install-services.cjs",
    "uninstall-services": "node scripts/uninstall-services.cjs",
    "start-services": "net start \"DoctorApp Patient Service\" && net start \"DoctorApp Visit Service\" && net start \"DoctorApp Reports Service\"",
    "stop-services": "net stop \"DoctorApp Patient Service\" && net stop \"DoctorApp Visit Service\" && net stop \"DoctorApp Reports Service\"",
    "test:sqlite": "node -e \"const db = require('better-sqlite3')(':memory:'); console.log('✅ better-sqlite3 working!'); db.close();\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.56.2",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "electron-store": "^8.1.0",
    "embla-carousel-react": "^8.3.0",
    "express": "^4.18.2",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.1",
    "next-themes": "^0.3.0",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.0.1",
    "node-machine-id": "^1.1.12",
